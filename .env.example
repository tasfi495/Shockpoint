# Paste your key from Google AI Studio (https://aistudio.google.com/apikey).
# The key lives only on the server: never in the JavaScript or in Git.
GEMINI_API_KEY=
# Gemini Flash model. If Google retires it, the app switches to an available Flash model automatically.
GEMINI_MODEL=gemini-3.8-flash
# Optional backup AI, used only when Gemini fails: an xAI Grok key (xai-...) or a Groq key (gsk_...).
GROK_API_KEY=
